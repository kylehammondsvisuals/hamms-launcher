{
  "name": "hamms-launcher",
  "productName": "HAMMS Studios",
  "version": "1.1.2",
  "description": "Download, update and play every HAMMS Studios game.",
  "author": "HAMMS Studios",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.hammsstudios.launcher",
    "productName": "HAMMS Studios",
    "files": ["main.js", "preload.js", "config.json", "src/**", "renderer/**", "build/icon.png", "package.json"],
    "extraResources": [{ "from": "store-bundle", "to": "store" }],
    "protocols": [{ "name": "HAMMS Studios", "schemes": ["hamms"] }],
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "uninstallerIcon": "build/uninstallerIcon.ico",
      "shortcutName": "HAMMS Studios",
      "artifactName": "HAMMS-Studios-Setup-${version}.exe"
    },
    "publish": [{ "provider": "github", "owner": "kylehammondsvisuals", "repo": "hamms-launcher" }]
  }
}
